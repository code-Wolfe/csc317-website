
<main class="main view-main">
    <section class="content view-content">
        {{#if currentPost}}
        <p>{{currentPost.title}}</p>
        <div class="post-meta">
            <span class="username-wrapper"><a class="username-link">{{currentPost.username}}</a></span>
            <span class="post-time">{{formatDate currentPost.created_at}}</span>
        </div>

            <video controls poster="#">
                <source src="/{{currentPost.video}}" type="video/mp4">
            </video>
            <p>{{currentPost.description}}</p>

            <section class="comments">
                <h2>Comments</h2>
                <!-- Add comments here if you have any -->
            </section>
        {{else}}
            <p>Post not found</p>
        {{/if}}
    </section>
</main>