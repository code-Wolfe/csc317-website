
<div class = "container-login">
    <main class="login-main" role="main">
        <form id="loginForm" action = "/users/login" 
                enctype= = "application/x-www-form-urlencoded" method = "POST">
                <h2>Login</h2>
                    <div>
                        <label for="username">Username:</label>
                        <input type="text" id="username" name="username">
                        <span id="usernameValidation" class="validation-message"></span>
                    </div>
                    
                    <div>
                        <label for="password">Password:</label>
                        <input type="password" id="password" name="password">
                        <span id="passwordValidation" class="validation-message"></span>
                    </div>
                    
                    
                    <button type="submit">Login</button>

            </form>

        <p class="register-link">
        Don't have an account? <a href="/registration">Register here</a>
        </p>
    </main>    
</div>

